# ---- Secrets: NEVER commit real credentials ----
# Only .env.example (placeholders) is tracked; every other env file is ignored.
.env
.env.*
!.env.example
# dbt local creds / state (profiles.yml here is env-var-only, so it stays tracked)
dbt_ciena/.user.yml
dbt_ciena/profiles.yml.test

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- dbt build artifacts (regenerated by `dbt`) ----
dbt_ciena/target/
dbt_ciena/dbt_packages/
dbt_ciena/logs/

# ---- Pipeline data & logs (generated at runtime) ----
landing/
logs/
dashboard.html

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*~
~BROMIUM/
**/~BROMIUM/
