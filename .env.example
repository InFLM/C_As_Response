# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# (.env and .env.* are git-ignored; only this .env.example is tracked.)

# SQL Server
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_SERVER=your-sql-server-host
SQLSERVER_DATABASE=Ciena
SQLSERVER_USER=your-username
SQLSERVER_PASSWORD=__set_in_local_.env__
SQLSERVER_TRUST_CERT=yes

# Snowflake
SNOWFLAKE_ACCOUNT=your-account-locator
SNOWFLAKE_USER=your-snowflake-user
SNOWFLAKE_ROLE=DEVELOPER
SNOWFLAKE_WAREHOUSE=DATA_IMPORT_LARGE
SNOWFLAKE_DATABASE=CIENA
SNOWFLAKE_SCHEMA=PCC
# Key-pair auth: base64-encoded PEM private key (decoded to PEM for dbt at runtime).
SNOWFLAKE_PRIVATE_KEY=__base64_encoded_pem_private_key__
# Or password auth instead of key-pair:
# SNOWFLAKE_PASSWORD=__set_in_local_.env__

# ETL behavior
LANDING_DIR=./landing
AS_RESPONSE_LOOKBACK_DAYS=15
# RAW_AS_RESPONSE_TABLE=CIENA.PCC.RAW_AS_RESPONSE_C
# RUN_DBT=true

# Microsoft Teams notifications (optional). Create via Teams channel ->
# Workflows -> "Post to a channel when a webhook request is received".
TEAMS_WEBHOOK_URL=__optional_teams_workflow_webhook_url__
